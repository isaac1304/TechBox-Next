# SMTP credentials used by /api/contact to send the contact-form email
# via Google Workspace. Generate an "App Password" for gerencia@techbox.cr:
# Google Account -> Security -> 2-Step Verification -> App passwords
# (requires 2-Step Verification to be enabled on the account).
SMTP_USER=gerencia@techbox.cr
SMTP_PASSWORD=

# Optional overrides — defaults match Google Workspace/Gmail.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# Optional: where contact-form submissions are delivered.
# Defaults to site.email (gerencia@techbox.cr) if unset.
# CONTACT_TO_EMAIL=gerencia@techbox.cr
